# ============================================================================
# ZenPro — Environment Variables
# Copy to .env.local and fill in. Every integration degrades gracefully when
# its variables are missing (cache/AI/embeddings are skipped, not required).
# ============================================================================

# --- Supabase (Database + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (AI summaries, morning brief) ---
OPENAI_API_KEY=

# --- Upstash Redis (caching) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- GitHub (raises rate limit from 60/hr to 5000/hr for GitHub Radar) ---
GITHUB_ACCESS_TOKEN=

# --- Cron protection (Vercel Cron sends this as a Bearer token) ---
CRON_SECRET=

# --- Sentry (error monitoring) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ============================================================================
# Feature flags (all default to sensible values — see config/features.ts)
# ============================================================================
# NEXT_PUBLIC_FF_GOOD_MORNING=true
# NEXT_PUBLIC_FF_THINGS_TO_KNOW=true
# NEXT_PUBLIC_FF_TECH_INTELLIGENCE=true
# NEXT_PUBLIC_FF_GITHUB_RADAR=true
# NEXT_PUBLIC_FF_MARKET_PULSE=true
# NEXT_PUBLIC_FF_CAREER_RADAR=true
# NEXT_PUBLIC_FF_COMMAND_CENTER=true
# NEXT_PUBLIC_FF_BUSY_MODE=true
# NEXT_PUBLIC_FF_SAVED_ITEMS=true
